{
  "name": "seineminer-site",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/sync-brand-assets.mjs && node scripts/check-content.mjs && node scripts/check-release-facts.mjs && node scripts/check-benchmark-facts.mjs",
    "build": "astro build",
    "predev": "node scripts/sync-brand-assets.mjs",
    "dev": "astro dev --port 8791",
    "preview": "astro preview --port 8791",
    "check": "node scripts/check-content.mjs && node scripts/check-release-facts.mjs && node scripts/check-benchmark-facts.mjs",
    "overlap": "node scripts/check-content.mjs --overlap",
    "indexnow": "node scripts/indexnow.mjs",
    "check:release": "node scripts/check-release-facts.mjs --live",
    "test": "node --test scripts/check-release-facts.test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.3",
    "@astrojs/rss": "4.0.19",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "astro": "7.3.8",
    "satori": "0.47.1",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  }
}
