---
// Labelled aside used by <Answer>, <Note> and <Warning> in posts.
import { useTranslations } from '../../i18n/ui';
import { localeFromUrl } from '../../lib/locale-from-url';

interface Props { kind: 'answer' | 'note' | 'warning' }
const { kind } = Astro.props;
const t = useTranslations(localeFromUrl(Astro.url));
const label = { answer: t('blockAnswer'), note: t('blockNote'), warning: t('blockWarning') }[kind];
---
<div class={`block ${kind}`}>
  <div class="block-label">{label}</div>
  <slot />
</div>
