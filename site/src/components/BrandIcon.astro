---
import { Image } from 'astro:assets';
import icon from '../../../docs/assets/brand/icon-180.png';

interface Props { size: number; class?: string }
const { size, class: className } = Astro.props;
---
<Image src={icon} width={size} height={size} densities={[1, 2]} format="webp"
       alt="" class={className} loading="eager" />
