---
import '../styles/blog.css';
import Base from '../layouts/Base.astro';
import { Content } from '../../../PRIVACY.md';
---
<Base locale="en" path="/privacy/" title="Privacy policy · seine" description="How Seine handles miner telemetry and website activity counts, retention and your controls." alternates={false}>
  <main class="wrap">
    <article class="prose privacy"><Content /></article>
  </main>
</Base>
<style>
  .privacy { padding-top: 64px; }
  .privacy :global(h1) { color: var(--ink); font-size: clamp(2.1rem, 4.6vw, 3.2rem); line-height: 1.06; letter-spacing: -0.03em; }
</style>
