---
import '../styles/blog.css';
import { useTranslations } from '../i18n/ui';
import Base from '../layouts/Base.astro';

const t = useTranslations('en');
---
<Base locale="en" path="/404/" title="Not found · seine" description={t('notFoundDescription')} robots="noindex" alternates={false}>
<main class="wrap">
  <header class="page-head">
    <h1>{t('notFoundTitle')}</h1>
    <p class="lead"><a href="/">{t('notFoundHome')}</a>{' · '}<a href="/blog/">{t('notFoundBlog')}</a></p>
  </header>
</main>
</Base>
