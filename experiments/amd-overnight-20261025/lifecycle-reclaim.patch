+@contextmanager
+def reclaim_stress(unit):
+    group = Path('/sys/fs/cgroup') / state(unit)['cgroup'].lstrip('/')
+    with (OUT / 'reclaim-load.log').open('w') as log:
+        child = subprocess.Popen([sys.executable, '-B', str(ROOT / 'reclaim_load.py'),
+            '--cgroup', str(group), '--bytes', str(2 * 1024**3), '--seconds', '20'],
+            stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
+        try:
+            yield
+        finally:
+            if child.poll() is None:
+                os.killpg(child.pid, signal.SIGINT)
+                try:
+                    child.wait(timeout=3)
+                except subprocess.TimeoutExpired:
+                    os.killpg(child.pid, signal.SIGKILL)
+                    child.wait(timeout=3)
+            save('reclaim-load-exit.json', {'pid': child.pid, 'exit_code': child.returncode})
+
+
 def main():
